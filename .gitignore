__pycache__/
*.py[cod]
.pytest_cache/
.venv/

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Environments
.env
.envrc
.venv
env/
venv/

# Editor / IDE
.idea/
.vscode/
